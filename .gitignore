.venv/
__pycache__/
*.pyc

# Real credentials. settings.toml.example is the tracked template.
lessons/settings.toml

# Cached CIRCUITPY drive letter, per machine.
tools/.circuitpy

# Per-machine tool permission grants, not project config.
.claude/settings.local.json

# Scratch commit message. A fixed path, so one permission rule covers every
# commit instead of one per temp filename.
.commitmsg

lessons/L99*
lessons/L199*

# Which board is "A" and which is "B". Untracked because which boards are
# plugged in varies -- but the UIDs in it belong to the BOARDS, so the file
# travels with them to another machine unchanged. boards.json.example is the
# tracked template.
tools/boards.json
