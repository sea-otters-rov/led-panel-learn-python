{
  // ---------------------------------------------------------------------------
  // Save = deploy.
  //
  // Ctrl+S writes the file to the CIRCUITPY drive, CircuitPython notices the
  // write and restarts code.py.
  //
  // onFocusChange, NOT afterDelay. afterDelay is the dangerous one: it fires on
  // every pause in typing and would push half-written files to the board
  // mid-edit. onFocusChange only fires when you leave the editor, by which point
  // you have stopped typing -- and it means switching tabs or alt-tabbing away
  // cannot lose work, which "off" does not protect against.
  // ---------------------------------------------------------------------------
  "files.autoSave": "onFocusChange",

  // CircuitPython does not skip a UTF-8 BOM: it reports a SyntaxError on line 1
  // pointing at a valid docstring. Be explicit rather than trusting the default.
  "files.encoding": "utf8",

  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "lessons[\\\\/].*\\.(py|toml|json|txt|bmp|bdf|pcf|wav|mp3)$",
        "notMatch": "__pycache__",
        "cmd": "\"${workspaceFolder}\\.venv\\Scripts\\python.exe\" \"${workspaceFolder}\\tools\\sync.py\" \"${file}\"",
        "autoShowOutputPanel": "error"
      }
    ]
  },

  // ---------------------------------------------------------------------------
  // IntelliSense for CircuitPython.
  //
  // .venv holds circuitpython-stubs (board, displayio, digitalio, ...) pinned to
  // the firmware version, plus the plain-Python source of the Adafruit libraries
  // that ship to the board as .mpy. Pylance reads both, so `board.` autocompletes
  // real MatrixPortal pin names and nothing is underlined in red.
  // ---------------------------------------------------------------------------
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  // lessons\ is the board root, so a lesson importing another module resolves
  // the same way here as it does on the board.
  "python.analysis.extraPaths": ["${workspaceFolder}/lessons"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none"
  },

  // Serial console. Port and baud are picked in the Serial Monitor panel;
  // USB CDC ignores baud entirely, so any value works.
  "vscode-serial-monitor.lineEnding": "\r\n",

  // ---------------------------------------------------------------------------
  // Task Explorer: the sidebar list of tasks.
  //
  // Only "workspace" is on -- that is tasks.json, which is the list students are
  // meant to see. Every other provider is off ON PURPOSE, not for tidiness:
  // the defaults enable python, powershell, bash, batch, npm, eslint and tsc,
  // which would surface every .py and .ps1 in the repo as a clickable task. A
  // student clicking lessons\L101_say_something\main.py would run it on the
  // laptop, where board and displayio do not exist, and get a traceback with
  // nothing to do with their lesson.
  //
  // This object replaces the default wholesale rather than merging, so every
  // provider is listed explicitly. Add new keys here if the extension adds them.
  // ---------------------------------------------------------------------------
  "taskexplorer.enableSideBar": true,
  "taskexplorer.enabledTasks": {
    "ant": false,
    "apppublisher": false,
    "bash": false,
    "batch": false,
    "composer": false,
    "eslint": false,
    "gradle": false,
    "grunt": false,
    "gulp": false,
    "jenkins": false,
    "laravel": false,
    "make": false,
    "maven": false,
    "nodejs": false,
    "npm": false,
    "nsis": false,
    "perl": false,
    "pipenv": false,
    "powershell": false,
    "python": false,
    "ruby": false,
    "tsc": false,
    "webpack": false,
    "webpackwrap": false,
    "workspace": true
  },

  // ---------------------------------------------------------------------------
  // Formatting.
  //
  // Ruff, because tools\setup.ps1 already installs the extension on every
  // machine and ruff.toml is already the lint config -- so this adds no new
  // tool for a student to install and nothing new to keep in step. The
  // extension carries its own ruff binary; .venv does not need one.
  //
  // FORMAT only. Do NOT add "editor.codeActionsOnSave" with fixAll or
  // organizeImports: lessons\code.py imports a lesson for its side effect, and
  // a fix pass would delete the only functional line in the launcher and leave
  // the board running nothing. ruff.toml exempts that file from F401, but the
  // formatter is the safe half of ruff and the fixer is not -- keep it that way.
  //
  // This works because files.autoSave is onFocusChange. VS Code silently skips
  // formatOnSave when autoSave is "afterDelay", so if that ever changes, the
  // formatter stops running and nothing says so.
  //
  // lessons\font.py guards its glyph pictures with "# fmt: off". Verified:
  // without it the formatter squashes SHAPES from 300 lines to 48, one letter
  // per line, and the pictures stop being pictures.
  // ---------------------------------------------------------------------------
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [88],
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },

  "files.exclude": {
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true
  },
  "search.exclude": {
    ".venv": true,
    "firmware": true
  }
}
