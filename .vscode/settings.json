{
  // ---------------------------------------------------------------------------
  // Save = deploy.
  //
  // Ctrl+S writes the file to the CIRCUITPY drive, CircuitPython notices the
  // write and restarts code.py. Autosave is deliberately OFF: with it on, every
  // pause in typing would push a half-written file to the board and restart it.
  // ---------------------------------------------------------------------------
  "files.autoSave": "off",

  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "lessons[\\\\/].*\\.(py|toml|json|txt|bmp|bdf|pcf|wav|mp3)$",
        "notMatch": "__pycache__",
        "cmd": "\"${workspaceFolder}\\.venv\\Scripts\\python.exe\" \"${workspaceFolder}\\tools\\sync.py\" \"${file}\"",
        "autoShowOutputPanel": "error"
      }
    ]
  },

  // ---------------------------------------------------------------------------
  // IntelliSense for CircuitPython.
  //
  // .venv holds circuitpython-stubs (board, displayio, digitalio, ...) pinned to
  // the firmware version, plus the plain-Python source of the Adafruit libraries
  // that ship to the board as .mpy. Pylance reads both, so `board.` autocompletes
  // real MatrixPortal pin names and nothing is underlined in red.
  // ---------------------------------------------------------------------------
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  // lessons\ is the board root, so a lesson importing another module resolves
  // the same way here as it does on the board.
  "python.analysis.extraPaths": ["${workspaceFolder}/lessons"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none"
  },

  // Serial console. Port and baud are picked in the Serial Monitor panel;
  // USB CDC ignores baud entirely, so any value works.
  "vscode-serial-monitor.lineEnding": "\r\n",

  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [88]
  },

  "files.exclude": {
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true
  },
  "search.exclude": {
    ".venv": true,
    "firmware": true
  }
}
